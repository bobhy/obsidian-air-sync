{
	"name": "obsidian-air-sync",
	"version": "0.3.1",
	"description": "Sync your Obsidian vault bidirectionally with Google Drive.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint --max-warnings 0 .",
		"test": "vitest run",
		"test:watch": "vitest",
		"deploy": "node esbuild.config.mjs production && node deploy.mjs",
		"pretest:e2e": "npm run build",
		"test:e2e": "vitest run --config vitest.e2e.config.ts",
		"setup:e2e": "node --import jiti/register tests/e2e/setup-vault.ts",
		"cleanup:e2e": "node --import jiti/register tests/e2e/cleanup-vaults.ts",
		"setup:e2e:wdio": "node --import jiti/register tests/wdio/setup-wdio-token.ts",
		"test:e2e:single": "npm run build && wdio run wdio.conf.mts",
		"test:e2e:cross": "npm run build && wdio run wdio.multiremote.conf.mts"
	},
	"keywords": [],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "9.30.1",
		"@types/mocha": "^10.0.10",
		"@types/node": "^20.19.35",
		"@wdio/cli": "^9.27.0",
		"@wdio/globals": "^9.27.0",
		"@wdio/local-runner": "^9.27.0",
		"@wdio/mocha-framework": "^9.27.0",
		"@wdio/spec-reporter": "^9.27.0",
		"esbuild": "0.25.5",
		"eslint-plugin-obsidianmd": "0.1.9",
		"fake-indexeddb": "^6.2.5",
		"globals": "14.0.0",
		"jiti": "2.6.1",
		"obsidian": "^1.12.3",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.35.1",
		"vitest": "^4.0.18",
		"wdio-obsidian-service": "^3.0.2"
	},
	"dependencies": {
		"ignore": "^7.0.5",
		"js-md5": "^0.8.3",
		"node-diff3": "^3.2.0"
	}
}
